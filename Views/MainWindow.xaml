<Window x:Class="ClipVault.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipVault.Views"
        Title="ClipVault" Width="960" Height="600" MinWidth="700" MinHeight="400"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" Topmost="True"
        Background="{StaticResource WindowBg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown" PreviewTextInput="Window_PreviewTextInput">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ============ List row templates ============ -->
        <Style x:Key="RowHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <DataTemplate x:Key="RowHeaderTemplate">
            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="12" Margin="0,0,6,0"/>
                <TextBlock Style="{StaticResource RowHeader}" Text="{Binding KindLabel}"/>
                <TextBlock Style="{StaticResource RowHeader}" Text="{Binding SourceApp, StringFormat=' from {0}'}" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE840;" FontSize="11" DockPanel.Dock="Right" Foreground="{StaticResource Accent}"
                           ToolTip="Pinned" Visibility="{Binding Pinned, Converter={StaticResource BoolToVis}}" Margin="6,0,0,0"/>
                <TextBlock Style="{StaticResource RowHeader}" Text="{Binding TimeAgo}" DockPanel.Dock="Right"/>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="TextRow">
            <StackPanel Margin="12,8">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowHeaderTemplate}"/>
                <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           MaxHeight="54" LineHeight="18" LineStackingStrategy="BlockLineHeight" FontSize="12.5"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ImageRow">
            <StackPanel Margin="12,8">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowHeaderTemplate}"/>
                <Border BorderBrush="{StaticResource Border}" BorderThickness="1" HorizontalAlignment="Left" Background="White" Padding="2">
                    <Image Source="{Binding Thumbnail}" MaxHeight="96" MaxWidth="240" Stretch="Uniform" StretchDirection="DownOnly"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock Text="{Binding Details}" Style="{StaticResource RowHeader}" Margin="0,4,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FilesRow">
            <StackPanel Margin="12,8">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowHeaderTemplate}"/>
                <TextBlock Text="{Binding Preview}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           MaxHeight="54" LineHeight="18" LineStackingStrategy="BlockLineHeight" FontSize="12.5"/>
                <TextBlock Text="{Binding Details}" Style="{StaticResource RowHeader}" Margin="0,4,0,0"/>
            </StackPanel>
        </DataTemplate>

        <local:ClipTemplateSelector x:Key="RowSelector"
                                    Text="{StaticResource TextRow}" Image="{StaticResource ImageRow}" Files="{StaticResource FilesRow}"/>

        <!-- ============ Preview templates ============ -->
        <DataTemplate x:Key="TextPreview">
            <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0" Background="Transparent" Padding="12" FontSize="13"
                     FontFamily="Segoe UI, Consolas" IsReadOnlyCaretVisible="True"/>
        </DataTemplate>

        <DataTemplate x:Key="ImagePreview">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="12">
                <Image Source="{Binding FullImage}" Stretch="Uniform" StretchDirection="DownOnly"
                       HorizontalAlignment="Left" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="FilesPreview">
            <ItemsControl ItemsSource="{Binding Files}" Margin="12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <local:ClipTemplateSelector x:Key="PreviewSelector"
                                    Text="{StaticResource TextPreview}" Image="{StaticResource ImagePreview}" Files="{StaticResource FilesPreview}"/>

        <!-- ============ List item container ============ -->
        <Style x:Key="RowStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6,2"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#BFDBFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <DockPanel Grid.Row="0" LastChildFill="True">
                <Image Source="pack://application:,,,/Assets/ClipVault.ico" Width="18" Height="18" Margin="12,0,8,0"/>
                <TextBlock Text="ClipVault" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13"/>
                <TextBlock x:Name="CountText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="0,4,6,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" Click="Settings_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="Close (Esc)" Click="Close_Click"/>
                </StackPanel>
                <Border/>
            </DockPanel>

            <!-- Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" MinWidth="280"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*" MinWidth="240"/>
                </Grid.ColumnDefinitions>

                <!-- Left: search + list -->
                <Grid Grid.Column="0" Margin="10,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="10,0" Height="36">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" x:Name="SearchBox" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                     TextChanged="SearchBox_TextChanged" FontSize="13"/>
                            <TextBlock Grid.Column="1" x:Name="SearchHint" Text="Search history..." Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                       Margin="2,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Margin="0,8,0,0">
                        <Grid>
                            <ListBox x:Name="ItemList" BorderThickness="0" Background="Transparent"
                                     ItemTemplateSelector="{StaticResource RowSelector}" ItemContainerStyle="{StaticResource RowStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
                                     SelectionChanged="ItemList_SelectionChanged" MouseDoubleClick="ItemList_MouseDoubleClick" Padding="0,4">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Paste" InputGestureText="Enter" Click="Paste_Click"/>
                                        <MenuItem Header="Copy only" InputGestureText="Ctrl+Enter" Click="Copy_Click"/>
                                        <Separator/>
                                        <MenuItem x:Name="PinMenu" Header="Pin" InputGestureText="Ctrl+P" Click="Pin_Click"/>
                                        <MenuItem Header="Delete" InputGestureText="Del" Click="Delete_Click"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                            <TextBlock x:Name="EmptyText" Text="Nothing here yet. Copy something and it will show up." Foreground="{StaticResource Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="24" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </Grid>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" Focusable="False"/>

                <!-- Right: preview -->
                <Border Grid.Column="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Margin="0,0,10,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="12,6">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Style="{StaticResource PrimaryButton}" Content="Paste" Click="Paste_Click" Margin="0,0,6,0" ToolTip="Paste into the previous app (Enter)"/>
                                    <Button Style="{StaticResource TextButton}" Content="Copy" Click="Copy_Click" Margin="0,0,6,0" ToolTip="Copy to clipboard only (Ctrl+Enter)"/>
                                    <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE718;" Click="Pin_Click" ToolTip="Pin / unpin (Ctrl+P)"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Click="Delete_Click" ToolTip="Delete (Del)"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="PreviewTitle" FontWeight="SemiBold" Text="Preview" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="PreviewMeta" Foreground="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ContentControl Grid.Row="1" x:Name="PreviewContent" ContentTemplateSelector="{StaticResource PreviewSelector}" Focusable="False"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer -->
            <DockPanel Grid.Row="2" Margin="12,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="Clear history" Padding="10,3" FontSize="11.5" Click="Clear_Click" VerticalAlignment="Center"/>
                <TextBlock Foreground="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center"
                           Text="Enter paste  ·  Ctrl+Enter copy  ·  Ctrl+1-9 quick paste  ·  Ctrl+P pin  ·  Del delete  ·  Esc close"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
