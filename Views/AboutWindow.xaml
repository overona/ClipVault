<Window x:Class="ClipVault.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About ClipVault" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SourceInitialized="Window_SourceInitialized">
    <StackPanel Margin="20">
        <DockPanel>
            <Image Source="pack://application:,,,/Assets/ClipVault.ico" Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Top"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="ClipVault" FontWeight="SemiBold" FontSize="18"/>
                <TextBlock x:Name="VersionText" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/>
                <TextBlock x:Name="AuthorText" Margin="0,6,0,0"/>
            </StackPanel>
        </DockPanel>

        <TextBlock TextWrapping="Wrap" Margin="0,14,0,0" Foreground="{DynamicResource Muted}"
                   Text="A clipboard history manager for Windows. Everything you copy stays on this computer, in your own user profile. ClipVault never sends clipboard contents anywhere."/>

        <TextBlock Text="Disclaimer" FontWeight="SemiBold" Margin="0,16,0,4"/>
        <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="12">
            <TextBlock x:Name="DisclaimerText" TextWrapping="Wrap" FontSize="12" LineHeight="17"/>
        </Border>

        <DockPanel Margin="0,16,0,0">
            <Button Content="Close" Style="{StaticResource PrimaryButton}" IsDefault="True" IsCancel="True" Width="90" DockPanel.Dock="Right"/>
            <Button x:Name="DataFolderButton" Content="Open data folder" Style="{StaticResource TextButton}" HorizontalAlignment="Left" Click="DataFolder_Click"/>
        </DockPanel>
    </StackPanel>
</Window>
